PORT=5000
DATABASE_URL="file:./dev.db"
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN=24h
NODE_ENV="development"
# Список разрешённых CORS-origins через запятую (дефолт для разработки)
CORS_ORIGINS=http://localhost:5173
# Опорная дата прогноза демо (ТЗ-доработка WP-7 §9/§13) = последняя дата демо-выписки
# (statement-demo-C001.csv: 2026-09-29). Применяется ТОЛЬКО к демо-учётке
# demo@cashflow.ru; у обычных пользователей asOf берётся из их выписки (TЗ §9).
# После regeneration demo/ через pick-demo.mjs — обновить. Чтобы демо-прогноз
# шёл от текущей даты, закомментируйте строку.
FORECAST_AS_OF=2026-09-30